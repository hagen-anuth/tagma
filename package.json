{
    "name": "tagma",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "packageManager": "yarn@4.18.1",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "typecheck": "next typegen && tsc --noEmit",
        "format": "prettier --write \"**/*.{ts,tsx,md,css}\"",
        "test": "vitest run",
        "verify": "yarn typecheck && yarn lint && yarn test && yarn build",
        "db:up": "docker compose up -d --wait",
        "db:down": "docker compose down",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.9.2",
        "class-variance-authority": "^0.7.1",
        "cmdk": "^1.1.1",
        "cn": "^0.5.0",
        "dayjs": "^1.11.23",
        "drizzle-orm": "^0.45.4",
        "lucide-react": "^1.59.0",
        "next": "16.4.2",
        "pg": "^8.23.1",
        "radix-ui": "^1.8.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-hook-form": "^7.90.0",
        "server-only": "^0.0.1",
        "shadcn": "^4.22.1",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@next/env": "16.4.2",
        "@tailwindcss/turbopack": "^4",
        "@types/node": "^22",
        "@types/pg": "^8.23.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "drizzle-kit": "^0.31.11",
        "eslint": "^9",
        "eslint-config-next": "16.4.2",
        "eslint-plugin-import-x": "^4.17.1",
        "prettier": "^3.9.10",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "typescript": "^5",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
